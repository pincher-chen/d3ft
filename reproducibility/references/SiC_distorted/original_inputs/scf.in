&control
 calculation='scf',prefix='calc',outdir='./tmp',pseudo_dir='/XYFS03/SSD_POOL/nscc-gz_pinchen/nscc-gz_pinchen_4/work/DFT/paper/jctc/fresh_validation_20261007/inputs/pseudopotentials',verbosity='high',tprnfor=.true.,tstress=.true.
/
